    {"id": "csv_inappropriate", "family": "inappropriate_reuse", "file": "wide", "request": "Reuse the saved procedure on {path}", "expected": {"op": "clarify", "min": null, "order": "desc"}},
    {"id": "csv_unsupported_below", "family": "unsupported", "file": "alpha", "request": "Summarize amounts below 10 using {path}", "expected": {"op": "unsupported", "min": null, "order": "desc"}},
    {"id": "csv_fresh_no_inherit", "family": "new_composition", "file": "alpha", "request": "Summarize amounts by region using {path}", "expected": {"op": "sum", "min": null, "order": "desc"}, "prior_request": "Summarize amounts by region at least 5 using {path}"}
