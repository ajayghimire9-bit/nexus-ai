# Inert documentation template, NOT installed under .github/workflows/.
# Installation requires separately authorized credentials with workflow scope.
name: Seed repository checks

# Manual only: adding this workflow does not start cloud compute or experiments.
on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  source-and-fixtures:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4, verified at setup
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5, verified at setup
        with:
          python-version: '3.11'
      - name: Install test dependency only
        run: python -m pip install 'pytest>=8,<10'
      - name: Check documentation and source layout
        run: python -I -S scripts/check_repository.py
      - name: Test Seed and repository contracts
        run: python -m pytest tests/test_seed.py tests/test_repository_layout.py
      - name: Audit recorded incomplete capture without executing it
        run: python -I -S scripts/verify_seed_comparison.py --allow-partial
